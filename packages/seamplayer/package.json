{
  "name": "seamplayer",
  "version": "0.1.2",
  "description": "A poster-first video player for React, Astro, Svelte, Vue and plain JavaScript, with a filmstrip timeline, chapters, captions and quality controls.",
  "keywords": [
    "react",
    "video",
    "video-player",
    "player",
    "hls",
    "chapters",
    "captions",
    "astro",
    "svelte",
    "vue",
    "web-component",
    "expo"
  ],
  "homepage": "https://opensource.seamlift.com/seamplayer",
  "license": "MIT",
  "author": "Seamlift",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/element.js",
    "./dist/element.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && bun scripts/copy-styles.ts",
    "dev": "tsup --watch --onSuccess \"bun scripts/copy-styles.ts\"",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests",
    "check": "bun run format:check && bun run lint && bun run check-types && bun run build && bun test",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check",
    "verify:package": "bun scripts/verify-package.ts",
    "release": "bun publish --access public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "hls.js": "^1.6.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@types/bun": "1.4.2",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.7.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.50.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARITRA69/seamlift-opensource.git",
    "directory": "packages/seamplayer"
  },
  "bugs": {
    "url": "https://github.com/ARITRA69/seamlift-opensource/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
