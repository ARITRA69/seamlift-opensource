{
  "name": "seamtranscode",
  "version": "0.1.0",
  "description": "Turn an uploaded video into adaptive HLS, a poster and a scrub sheet with one call. On your laptop, your server, in Docker or fanned out on Modal.",
  "keywords": [
    "video",
    "transcode",
    "transcoding",
    "hls",
    "ffmpeg",
    "thumbnails",
    "sprite-sheet",
    "s3",
    "r2"
  ],
  "homepage": "https://opensource.seamlift.com/seamtranscode",
  "license": "MIT",
  "author": "Seamlift",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seamtranscode": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./s3": {
      "import": {
        "types": "./dist/s3.d.ts",
        "default": "./dist/s3.js"
      },
      "require": {
        "types": "./dist/s3.d.cts",
        "default": "./dist/s3.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./player": {
      "import": {
        "types": "./dist/player.d.ts",
        "default": "./dist/player.js"
      },
      "require": {
        "types": "./dist/player.d.cts",
        "default": "./dist/player.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests",
    "check": "bun run format:check && bun run lint && bun run check-types && bun run build && bun test tests",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check",
    "verify:package": "bun scripts/verify-package.ts",
    "release": "bun publish --access public"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@eslint/js": "^9.39.1",
    "@types/bun": "1.4.2",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "tsup": "^8.5.1",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.50.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARITRA69/seamlift-opensource.git",
    "directory": "packages/seamtranscode"
  },
  "bugs": {
    "url": "https://github.com/ARITRA69/seamlift-opensource/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
